{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCR Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "severity",
    "status",
    "confidence",
    "origin",
    "summary",
    "evidence",
    "recommendations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "data",
        "architecture",
        "code",
        "testing",
        "performance",
        "operations",
        "documentation",
        "context",
        "tokens",
        "product",
        "dependencies",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "info"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "suspected",
        "not_checked",
        "not_applicable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "static_check",
        "command",
        "agent_review",
        "user_provided"
      ]
    },
    "summary": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "command",
