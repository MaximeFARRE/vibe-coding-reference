{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCR Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "severity",
    "status",
    "confidence",
    "origin",
    "summary",
    "evidence",
    "recommendations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "data",
        "architecture",
        "code",
        "testing",
        "performance",
        "operations",
        "documentation",
        "context",
        "tokens",
        "product",
        "dependencies",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "info"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "suspected",
        "not_checked",
        "not_applicable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "static_check",
        "command",
        "agent_review",
        "user_provided"
      ]
    },
    "summary": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "command",
              "log",
              "configuration",
              "user_statement",
              "source"
            ]
          },
          "summary": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "redacted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks_of_fix": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants_to_preserve": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
