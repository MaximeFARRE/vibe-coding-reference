{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCR Audit Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "workflow",
    "target",
    "profile",
    "checks",
    "limitations",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "type": "string",
      "enum": [
        "start",
        "rescue",
        "improve",
        "tokens"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "read_only",
            "proposal",
            "approved_change"
          ]
        },
        "git_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_checked",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string"
